{
  "background": {
    "persistent": true
  },
  "options_ui": {
    "chrome_style": false
  },
  "optional_permissions": [
    "background"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "incognito": "split",
  "minimum_chrome_version": "63"
}